# Anthropic API Key for Claude
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================================================
# AWS Bedrock Alternative (optional)
# If you want to use AWS Bedrock instead of Anthropic API, uncomment below
# and see docs/BEDROCK_SETUP.md for full configuration details
# ============================================================================
# USE_BEDROCK=true
# AWS_REGION=us-east-1
# AWS_PROFILE=your-bedrock-profile-name

# GitHub Personal Access Token (for local testing)
GITHUB_TOKEN=your_github_pat_here

# For local testing - specify the repo and PR number
TEST_REPO_OWNER=owner
TEST_REPO_NAME=repo
TEST_PR_NUMBER=123
